<?xml version="1.0" encoding="utf-8"?>
<!-- The date style's content: the day, large, with the weekday and the lunar date under it. No clock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dreamContent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dreamDateMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E6FFFFFF"
        android:textSize="88sp"
        android:fontFamily="@string/font_extralight"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/dreamDateWeek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:textColor="#99FFFFFF"
        android:textSize="24sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.10"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/dreamDateLunar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:textColor="#8CFFFFFF"
        android:textSize="18sp"
        android:fontFamily="@string/font_regular"
        android:letterSpacing="0.12" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One source in the Inputs dropdown. Built from the settings page's row (48dp, white pill on focus,
     dark label) so the list under the pill reads as the same surface as the control panel and the dialogs.
     Kept separate from item_input, which the library and the quick settings still draw in their own shape. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="2dp"
    android:background="@drawable/settings_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:tint="@drawable/pill_text" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:fontFamily="@string/font_medium"
        android:singleLine="true"
        android:textColor="@drawable/pill_text"
        android:textSize="16sp" />

    <View
        android:id="@+id/dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/status_dot" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:fontFamily="@string/font_body"
        android:letterSpacing="0.04"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="11sp" />
</LinearLayout>

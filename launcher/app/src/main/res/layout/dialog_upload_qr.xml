<?xml version="1.0" encoding="utf-8"?>
<!-- The "add wallpapers from a phone" dialog: a QR code large enough to scan from the sofa, the address in
     text for anyone who would rather type it, and where the pictures end up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/upload_qr_hint"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@string/font_body" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/qr_card"
        android:padding="12dp">

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/qrAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:letterSpacing="0.02"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/upload_qr_footnote"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:lineSpacingExtra="2sp"
        android:fontFamily="@string/font_body" />
</LinearLayout>

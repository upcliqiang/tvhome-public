<?xml version="1.0" encoding="utf-8"?>
<!-- The Inputs dropdown's sheet: the same dark grey gradient, hairline and rounded corner as the control
     panel card and the dialogs, so a menu under the pill belongs to the same surface family. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F2454549"
        android:endColor="#F22B2B2E" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- A round button inside the control panel. Focus flips it to solid white and the icon to dark (see
     color/control_panel_icon.xml), the same cue Aerial's three round buttons use. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F5FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#38FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog is the same floating glass sheet as the control panel card, so the two read as one family. It is
     the window background, therefore the corners cut straight through to the dimmed page behind. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F2454549"
        android:endColor="#F22B2B2E" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
